{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=uploads.db"
  },
  "Auth": {
    "Enabled": false,
    "ApiKey": "",
    "HeaderName": "X-Api-Key",
    "AnonymousPathPrefixes": [ "/health", "/swagger" ]
  },
  "StorageOptions": {
    "Provider": "FileSystem",
    "TempPath": "temp",
    "FinalPath": "uploads",
    "PendingTtlHours": 24,
    "CleanupIntervalMinutes": 60,
    "MaxFileSizeBytes": 21474836480,
    "MaxChunkSizeBytes": 33554432,
    "MaxPendingSessionsPerIp": 5,
    "MaxTotalStoredBytes": 214748364800,
    "MaxStoredBytesPerIp": 53687091200,
    "MaxConcurrentDiskIo": 8,
    "MergeParallelism": 4,
    "SinglePassMergeAndHash": true,
    "RequireChunkCrc32": false,
    "RequireChunkSha256": false,
    "SessionCacheTtlSeconds": 30,
    "Hasher": "Hardware",
    "AllowedExtensions": [],
    "BlockedExtensions": [ "exe", "bat", "cmd", "com", "msi", "scr", "ps1", "vbs", "js", "jar", "dll", "sh" ]
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "uploads",
    "AccessKey": "",
    "SecretKey": "",
    "TempPrefix": "temp/",
    "FinalPrefix": "files/",
    "ForcePathStyle": true
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "admin",
    "Password": "admin",
    "VirtualHost": "/",
    "Exchange": "fileuploader.events",
    "RoutingKeyCompleted": "upload.completed",
    "RoutingKeyAborted": "upload.aborted",
    "RoutingKeyFailed": "upload.failed"
  },
  "Webhook": {
    "Url": "",
    "TimeoutSeconds": 10
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  }
}
