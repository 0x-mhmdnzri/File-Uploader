{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "WebApi.Services.UploadService": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=uploads.db"
  },
  "MultiInstance": {
    "Enabled": false,
    "SharedPartStoreConfigured": false,
    "RequirePostgres": true,
    "ForbidExternalObjectStoreAsProductPlane": true
  },
  "Auth": {
    "Enabled": false,
    "ApiKey": "",
    "HeaderName": "X-Api-Key",
    "AnonymousPathPrefixes": [
      "/health",
      "/swagger"
    ]
  },
  "StorageOptions": {
    "Provider": "FileSystem",
    "TempPath": "temp",
    "FinalPath": "uploads",
    "PendingTtlHours": 24,
    "CleanupIntervalMinutes": 60,
    "MaxFileSizeBytes": 21474836480,
    "MaxChunkSizeBytes": 33554432,
    "MaxPendingSessionsPerIp": 5,
    "MaxTotalStoredBytes": 214748364800,
    "MaxStoredBytesPerIp": 53687091200,
    "MaxConcurrentDiskIo": 8,
    "MergeParallelism": 4,
    "SinglePassMergeAndHash": true,
    "AlwaysComputeFullChecksum": true,
    "DeduplicateByContent": true,
    "ContentSampleBytes": 1048576,
    "RequireChunkCrc32": false,
    "RequireChunkSha256": false,
    "SessionCacheTtlSeconds": 30,
    "Hasher": "Hardware",
    "AllowedExtensions": [],
    "BlockedExtensions": [
      "exe",
      "bat",
      "cmd",
      "com",
      "msi",
      "scr",
      "ps1",
      "vbs",
      "js",
      "jar",
      "dll",
      "sh"
    ]
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "uploads",
    "AccessKey": "",
    "SecretKey": "",
    "TempPrefix": "temp/",
    "FinalPrefix": "files/",
    "ForcePathStyle": true
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "admin",
    "Password": "admin",
    "VirtualHost": "/",
    "Exchange": "fileuploader.events",
    "RoutingKeyCompleted": "upload.completed",
    "RoutingKeyAborted": "upload.aborted",
    "RoutingKeyFailed": "upload.failed"
  },
  "Webhook": {
    "Url": "",
    "TimeoutSeconds": 10
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "Limits": {
      "MaxConcurrentConnections": 1000,
      "MaxConcurrentUpgradedConnections": 1000,
      "MaxRequestBodySize": 104857600,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30",
      "Http2": {
        "MaxStreamsPerConnection": 200,
        "HeaderTableSize": 4096,
        "MaxFrameSize": 16384,
        "MaxRequestHeaderFieldSize": 16384,
        "InitialConnectionWindowSize": 1048576,
        "InitialStreamWindowSize": 786432
      }
    }
  }
}
