{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=uploads.db"
  },
  "StorageOptions": {
    "TempPath": "temp",
    "FinalPath": "uploads",
    "PendingTtlHours": 24,
    "CleanupIntervalMinutes": 60
  }
}
